# 复制为 .env；切勿提交真实值。生产环境应由 HTTPS 入口转发到前端。
APP_PORT=8080
MYSQL_DATABASE=MarketFlowDB
MYSQL_USER=marketflow
MYSQL_PASSWORD=replace-with-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password

APP_ENVIRONMENT=production
APP_DEBUG=false
APP_DATABASE_ECHO=false
APP_DATABASE_URL=mysql+aiomysql://marketflow:replace-with-strong-database-password@mysql:3306/MarketFlowDB?charset=utf8mb4
APP_SECRET_KEY=replace-with-a-long-random-secret-of-at-least-32-characters
# 使用 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成。
APP_AI_KEY_ENCRYPTION_KEY=replace-with-generated-fernet-key
APP_CORS_ORIGINS=["https://your-domain.example"]
APP_REDIS_URL=redis://redis:6379/0
APP_RUN_SCHEDULER=false
