# 复制为 .env 后按项目修改；不要提交真实凭据。
APP_PROJECT_NAME="MarketFlow"
APP_ENVIRONMENT="development"
APP_DEBUG=true
APP_API_V1_PREFIX="/api/v1"

# SQLAlchemy 异步 MySQL 连接，驱动必须使用 aiomysql。
APP_DATABASE_URL="mysql+aiomysql://username:password@localhost:3306/MarketFlowDB?charset=utf8mb4"
APP_DATABASE_ECHO=false

# 日志默认输出到控制台；需要文件日志时设置 APP_LOG_FILE。
APP_LOG_LEVEL="INFO"
APP_LOG_FILE=""

# 生产环境必须替换为密码学安全的长随机字符串。
APP_SECRET_KEY="dev-only-change-me-before-production"
APP_JWT_ALGORITHM="HS256"
APP_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Redis 是可选项；不使用时留空。
APP_REDIS_URL=""
APP_REDIS_MAX_CONNECTIONS=10
APP_REDIS_TIMEOUT=5

# JSON 数组；生产环境请填写实际前端地址。
APP_CORS_ORIGINS='["*"]'
