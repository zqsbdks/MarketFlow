# 本地开发示例：复制为 .env 后修改数据库连接。真实 .env 已由 Git 忽略。
# 完整变量说明：docs/CONFIGURATION.md。修改配置后需重启后端。
APP_PROJECT_NAME="MarketFlow"
APP_ENVIRONMENT="development"
APP_DEBUG=true
APP_API_V1_PREFIX="/api/v1"

# SQLAlchemy 异步 MySQL 连接，驱动必须使用 aiomysql。
APP_DATABASE_URL="mysql+aiomysql://username:password@localhost:3306/MarketFlowDB?charset=utf8mb4"
APP_DATABASE_ECHO=false

# 日志默认输出到控制台；需要文件日志时设置 APP_LOG_FILE。
APP_LOG_LEVEL="INFO"
APP_LOG_FILE=""

# 生产环境必须替换为密码学安全的长随机字符串。
APP_SECRET_KEY="dev-only-change-me-before-production"
APP_JWT_ALGORITHM="HS256"
APP_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 仅初始化店长脚本读取；已有数据库不需要再次设置或执行初始化。
APP_INITIAL_MANAGER_PASSWORD="请替换为初始店长密码"

# Redis 是可选项；不使用时留空。
APP_REDIS_URL=""
APP_REDIS_MAX_CONNECTIONS=10
APP_REDIS_TIMEOUT=5

# 本地开发默认在 Web 进程中执行任务；容器部署由独立 scheduler 服务执行。
APP_RUN_SCHEDULER=true
# 可选AI功能的凭据加密密钥，不是AI服务商API Key；按员工保存的API Key由前端配置。
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 不配置时不能保存员工AI Key；已配置后勿随意更换，否则旧Key无法解密。
APP_AI_KEY_ENCRYPTION_KEY=""

# JSON 数组；生产环境请填写实际前端地址。
APP_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
